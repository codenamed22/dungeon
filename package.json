{
  "name": "dungeons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/src/demo.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --test test/*.test.ts",
    "demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/demo.ts",
    "director": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/director.ts",
    "web": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "lock:public": "node scripts/public-lockfile.ts",
    "verify:neon": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/src/verify-neon.js"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^1.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
