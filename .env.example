# Use the connection string supplied by Neon, including its TLS parameters.
# Do not put real credentials in this example.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full

# Tests create and remove a uniquely named schema in this database.
# Use a dedicated test database, not production.
TEST_DATABASE_URL=postgresql://localhost:5432/dungeons_test

# Character and narrator agents call models through OpenRouter; only step and run
# need a key (https://openrouter.ai/keys). Do not put a real key in this example.
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY

# Optional. Any model ID listed by `npm run director -- models`; --model overrides both roles.
# DUNGEONS_MODEL=~deepseek/deepseek-pro-latest
# DUNGEONS_CHARACTER_MODEL=
# DUNGEONS_DM_MODEL=
# Reasoning effort: none, minimal, low, medium, high, xhigh, max, or default (the model's own).
# Unset means low, or the nearest effort the model offers. Reasoning tokens are billed as output.
# DUNGEONS_REASONING_EFFORT=low
# DUNGEONS_CHARACTER_EFFORT=
# DUNGEONS_DM_EFFORT=
# Output token limit per call, reasoning included.
# DUNGEONS_MAX_OUTPUT_TOKENS=4096
